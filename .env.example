# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
# Leave empty when using an external OpenAI-compatible API.
OLLAMA_BASE_URL=''

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# Personal WeChat / QQ bot gateway
# The feature and channel policy are configured in the RyanAI administrator
# panel. These values are only the signed internal transport/encryption layer.

# Published image used by docker-compose. Override the tag for a release build.
BOT_GATEWAY_IMAGE=ghcr.io/zhizinan1997/ryanai-bot-gateway
BOT_GATEWAY_DOCKER_TAG=latest

# Internal container port only. docker-compose.yaml does not publish it to the host.
BOT_GATEWAY_INTERNAL_PORT=8787

# Generate two independent secrets with: openssl rand -hex 32
# Never reuse WEBUI_SECRET_KEY or commit real values to source control.
BOT_GATEWAY_HMAC_SECRET=
BOT_GATEWAY_CREDENTIALS_ENCRYPTION_KEY=
BOT_GATEWAY_CREDENTIAL_MASTER_KEY=
BOT_GATEWAY_OPENCLAW_TOPOLOGY=shared
BOT_GATEWAY_COORDINATION_MODE=single
REDIS_URL=
BOT_GATEWAY_NODE_ID=
BOT_GATEWAY_ADVERTISE_URL=
BOT_GATEWAY_LEASE_TTL_MS=45000
BOT_GATEWAY_LEASE_RENEW_MS=15000
BOT_GATEWAY_SCHEDULER_MODE=shadow

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
