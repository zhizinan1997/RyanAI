{
	"name": "@ryanai/bot-gateway",
	"version": "0.1.0",
	"private": true,
	"description": "Fail-closed WeChat/QQ message gateway for RyanAI",
	"type": "module",
	"main": "dist/main.js",
	"exports": {
		".": "./dist/index.js",
		"./openclaw-plugin": "./dist/openclaw/plugin.js"
	},
	"files": [
		"dist",
		"openclaw.plugin.json",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/main.js",
		"dev": "tsx watch src/main.ts",
		"postinstall": "node scripts/harden-qqbot.cjs",
		"test": "tsc -p tsconfig.test.json && node --test .test-dist/test/all.test.js",
		"test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage .test-dist/test/all.test.js",
		"check": "npm run build && npm test"
	},
	"engines": {
		"node": ">=22.22.3"
	},
	"openclaw": {
		"extensions": [
			"./dist/openclaw/plugin.js"
		]
	},
	"dependencies": {
		"@tencent-connect/qqbot-connector": "1.2.0",
		"@tencent-connect/openclaw-qqbot": "2.0.0",
		"@tencent-weixin/openclaw-weixin": "2.4.6",
		"openclaw": "2026.7.1-2"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"typescript": "5.9.3"
	}
}
